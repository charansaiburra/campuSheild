# CampusShield Environment Configuration Example
DATABASE_URL=sqlite:///data/campushield.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# For production PostgreSQL:
# DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/campushield

# Generate a unique secret (at least 32 characters) and keep it in .env/secret storage.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
POSTGRES_PASSWORD=replace-with-a-unique-database-password
FACE_VERIFICATION_THRESHOLD=0.60
PERSON_DETECTOR_MODEL_PATH=yolo_models/yolov8n.pt
FACE_DETECTOR_MODEL_PATH=yolo_models/yolov8n-face.pt
MAX_PROCESSING_FPS=8
CROWD_ALERT_COOLDOWN_SECONDS=30
ZONE_BREACH_COOLDOWN_SECONDS=15

# SMTP Email Configuration (Optional; omit until SMTP is actually configured)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_FROM=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
# ALERT_EMAIL_RECIPIENTS=
